NEXT_PUBLIC_API_URL=http://localhost:8000

# Utilisé côté serveur par app/api/leads/capture/route.ts (BFF) — jamais exposé au client
BACKEND_URL=http://localhost:8000

# Sentry (capture d'exceptions) — DSN du projet sur sentry.io. Laisser vide en
# dev : sans valeur, Sentry.init() tourne mais n'envoie rien (voir
# sentry.client.config.ts / sentry.server.config.ts / sentry.edge.config.ts).
NEXT_PUBLIC_SENTRY_DSN=

# Cal.com — lien de l'event type utilisé par le bouton "Choisir un créneau
# maintenant" à l'étape 4 de la landing (ex. "iaconseil/estimation-gratuite").
# Vide = bouton masqué (voir components/landing/CalBooking.tsx).
NEXT_PUBLIC_CALCOM_LINK=

# A/B test headline + CTA de la landing /economiser — "A" (défaut) ou "B".
# Voir lib/variant.ts. On bascule cette valeur et on redéploie pour tourner
# un test A/B par fenêtre temporelle.
NEXT_PUBLIC_LANDING_VARIANT=A

# Pixels de tracking (lib/pixels.tsx) — vide = pixel désactivé. Voir
# docs/RETARGETING_META_TIKTOK.md pour la configuration des audiences.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Turnstile — clé de site (publique) du captcha invisible de
# l'étape 3 (components/landing/TurnstileWidget.tsx). Vide = captcha
# désactivé (doit rester cohérent avec TURNSTILE_SECRET_KEY côté backend).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
