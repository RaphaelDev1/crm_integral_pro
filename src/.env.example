# Copier ce fichier en .env (déjà gitignored) et remplir les valeurs réelles.
# Priorité : ces variables d'environnement > valeurs enregistrées en base via
# l'UI Admin (repli de compatibilité, cf. secrets_config.py). Tant qu'une
# variable ci-dessous n'est pas définie, l'ancien réglage Admin continue de
# fonctionner — mais il vaut mieux migrer chaque secret ici dès que possible.

# Environnement : "development" (défaut) ou "production". En production,
# CRM_API_SECRET devient obligatoire (voir jwt_auth.py).
APP_ENV=development

# SMTP (envoi d'emails — bilans clients, notifications de relances)
SMTP_SERVEUR=
SMTP_PORT=587
SMTP_USER=
SMTP_MDP=
SMTP_EXPEDITEUR=

# Claude Vision (lecture de factures photo/scan) — console.anthropic.com
ANTHROPIC_API_KEY=

# Notifications Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret de signature des JWT de l'API CRM interne (crm_api.py). Générer avec
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
CRM_API_SECRET=

# URL de src/crm_api.py (SQLite — prospects/clients/contrats/offres/diagnostic).
# Port 8003 par défaut, PAS 8000 : backend/ (Postgres) occupe le 8000 et
# n'implémente ni /contrats ni /offres — les faire cohabiter sur le même port a
# déjà causé des IntegrityError et des clients impossibles à supprimer (voir
# api_client.py). En usage courant crm_api.py ne tourne pas en continu, ce qui
# est normal : l'app retombe alors directement sur les modules *_engine.py.
CRM_API_URL=http://127.0.0.1:8003

# URL de backend/main.py (Postgres — dossiers/factures/honoraires/portail
# client). Aucun repli local : sans ce service lancé (uvicorn backend.main:app),
# ces fonctionnalités affichent un message clair au conseiller.
BACKEND_API_URL=http://127.0.0.1:8000

# SMS (bouton "Demander facture + test de débit" sur la fiche prospect,
# cf. sms_engine.py) — OVH par défaut, ou Twilio. Mêmes noms de variables que
# backend/.env.example : un compte OVH/Twilio déjà configuré côté backend/
# peut être réutilisé tel quel ici. Sans ces valeurs, le bouton retombe
# automatiquement sur l'email seul (et affiche le lien à copier manuellement).
SMS_PROVIDER=ovh
OVH_SMS_ENDPOINT=ovh-eu
OVH_SMS_SERVICE_NAME=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Base publique de la mini-page où le prospect envoie sa facture et son test de
# débit (servie par chatbot_api.py, port 8001 par défaut — voir la commande de
# lancement en haut de ce fichier). À changer pour l'URL publique réelle une
# fois chatbot_api.py déployé (ex. https://public.iaconseil.fr).
PORTAIL_PROSPECT_BASE_URL=http://127.0.0.1:8001

# Sentry (capture d'exceptions) — DSN du projet sur sentry.io. Laisser vide en
# dev : sentry_sdk.init() n'est appelé que si cette variable est renseignée
# (voir secrets_config.sentry_dsn(), initialisé en tête de app.py).
SENTRY_DSN=
