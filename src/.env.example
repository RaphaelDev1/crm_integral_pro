# Non utilisé par app.py pour l'instant — la config SMTP est saisie dans
# l'UI (Admin > Configuration) et vit en session_state, pas en variables
# d'environnement. Ce fichier documente les valeurs équivalentes si on
# bascule un jour vers une config par environnement (docker, CI, etc.).

SMTP_SERVEUR=
SMTP_PORT=587
SMTP_USER=
SMTP_MDP=
SMTP_EXPEDITEUR=
