# URL du backend FastAPI, utilisée uniquement côté serveur (route handlers
# app/api/*) : le navigateur ne parle jamais directement au backend.
BACKEND_URL=http://localhost:8000

# Sentry (capture d'exceptions) — DSN du projet sur sentry.io. Laisser vide en
# dev : sans valeur, Sentry.init() tourne mais n'envoie rien (voir
# sentry.server.config.ts / sentry.edge.config.ts / instrumentation-client.ts).
NEXT_PUBLIC_SENTRY_DSN=
