# URL du backend FastAPI, utilisée uniquement côté serveur (route handlers
# app/api/*) : le navigateur ne parle jamais directement au backend.
BACKEND_URL=http://localhost:8000

# Sentry (capture d'exceptions) — DSN du projet sur sentry.io. Laisser vide en
# dev : sans valeur, Sentry.init() tourne mais n'envoie rien (voir
# sentry.server.config.ts / sentry.edge.config.ts / instrumentation-client.ts).
# Valeur figée au build par Next.js : en Docker, passer --build-arg
# NEXT_PUBLIC_SENTRY_DSN=... (voir Dockerfile), une variable au `docker run`
# ne suffit pas.
NEXT_PUBLIC_SENTRY_DSN=

# Pas de variable SESSION_COOKIE_SECURE : le flag `secure` des cookies
# httpOnly (access_token/refresh_token) suit déjà NODE_ENV automatiquement
# (voir lib/server/backend.ts:cookieOptions) — true dès que NODE_ENV=production
# (posé par le Dockerfile), false sinon.
