# Copier ce fichier en backend/.env (gitignored) et remplir les valeurs réelles.

# "development" (défaut) ou "production". En production, CRM_API_SECRET
# devient obligatoire (voir backend/core/config.py).
APP_ENV=development

# Postgres (Neon en dev/prod) — pilote asyncpg requis pour SQLAlchemy async.
# Ex. postgresql+asyncpg://user:password@ep-xxx.neon.tech/ia_conseil
DATABASE_URL=

# Secret de signature des JWT — partagé avec src/jwt_auth.py tant que les deux
# API coexistent. Générer avec :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CRM_API_SECRET=

# Clé API Anthropic (console.anthropic.com) — utilisée par
# backend/services/kyc_engine.py (validation KYC via Claude Haiku vision).
ANTHROPIC_API_KEY=

# Yousign (signature électronique du mandat) — compte sandbox puis prod sur
# yousign.com. YOUSIGN_API_URL : https://api-sandbox.yousign.app/v3 (test) ou
# https://api.yousign.app/v3 (prod). YOUSIGN_WEBHOOK_SECRET : secret configuré
# côté Yousign pour signer les webhooks (HMAC-SHA256, en-tête
# X-Yousign-Signature-256).
YOUSIGN_API_KEY=
YOUSIGN_API_URL=https://api-sandbox.yousign.app/v3
YOUSIGN_WEBHOOK_SECRET=

# Broker/backend Celery (validation KYC et envoi Yousign en tâches async).
REDIS_URL=redis://localhost:6379/0

# Sentry (capture d'exceptions) — DSN du projet sur sentry.io. Laisser vide en
# dev : sentry_sdk.init() n'est appelé que si cette variable est renseignée
# (backend/main.py, backend/workers/celery_app.py).
SENTRY_DSN=

# URL du portail client Next.js (frontend-portail/) — autorisée en CORS par
# backend/main.py et utilisée pour construire les liens uniques envoyés aux
# clients (backend/services/token_engine.py).
PORTAIL_CLIENT_BASE_URL=http://localhost:3000

# S3 (Scaleway Object Storage recommandé, compatible API S3) — stockage
# chiffré des documents KYC (backend/services/storage_engine.py).
S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe (facturation client — abonnements Gestionnaire perso, commissions).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS (pour l'envoi du lien unique client) — OVH par défaut, ou Twilio.
SMS_PROVIDER=ovh
OVH_SMS_ENDPOINT=ovh-eu
OVH_SMS_SERVICE_NAME=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email transactionnel (Resend).
RESEND_API_KEY=
EMAIL_FROM=contact@iaconseil.fr
EMAIL_FROM_NAME=IA Conseil

# LRE (AR24 — lettre recommandée électronique) — envoi tracé des documents de
# démarche (résiliation, portabilité, changement de fournisseur). Aucun
# compte créé à ce jour ; tant que AR24_API_KEY est vide, la génération de
# document fonctionne mais l'envoi échoue proprement (statut "echouee").
# ⚠️ Schéma d'authentification exact (bearer vs login/mot de passe) à
# vérifier contre la doc AR24 réelle avant mise en prod.
AR24_API_KEY=
AR24_API_URL=https://api.ar24.fr
AR24_LOGIN=
AR24_PASSWORD=
